        function handleSaveNote(e) {
            e.preventDefault();
            const owner = document.getElementById('note-item-owner').value;
            const itemId = document.getElementById('note-item-id').value;
            const text = document.getElementById('note-text').value;

            const data = getItemsData();
            const items = data[owner] || [];
            const item = items.find(i => i.id === itemId);

            if (item) {
                if (!item.notes) item.notes = [];
                item.notes.push({
                    id: 'note_' + Math.random().toString(36).substr(2, 9),
                    author: currentUser,
                    text: text
                });
                saveItemsData(data);
                closeAddNoteModal();
                renderOtherPersonItems(owner);
            }
        }

        function deleteNote(ownerName, itemId, noteId) {
            const data = getItemsData();
            const items = data[ownerName] || [];
            const item = items.find(i => i.id === itemId);
            if (item && item.notes) {
                item.notes = item.notes.filter(n => n.id !== noteId);
                saveItemsData(data);
                renderOtherPersonItems(ownerName);
            }
        }

        // Helper escape html
        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

